{
  "$schema": "https://raw.githubusercontent.com/nicerandom/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "ESP Flash Download Tool",
  "version": "1.0.0",
  "identifier": "com.espflash.download.mac",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ESP Flash Download Tool",
        "width": 900,
        "height": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
